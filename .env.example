DB_HOST=<sql-server-host-reachable-from-wsl>
DB_PORT=<sql-server-port>
DB_NAME=<database-name>
DB_USER=<sql-server-login>
DB_PASSWORD='<sql-server-password>'
DB_ODBC_DRIVER=<installed-odbc-driver-name>
# Optional TLS settings. The defaults are encryption on and certificate verification on.
# DB_ENCRYPT=<yes-or-no>
# DB_TRUST_SERVER_CERTIFICATE=<yes-or-no>
